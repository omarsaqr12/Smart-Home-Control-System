// secrets.h.example
//
// Copy this file to `secrets.h` (same folder) and fill in your own values.
// `secrets.h` is git-ignored, so your real credentials never get committed.
//
//   cp main/secrets.h.example main/secrets.h
//
#pragma once

// ── Wi-Fi (2.4 GHz network) ──────────────────────────────────────────────
#define WIFI_SSID        "your-network-name"
#define WIFI_PASS        "your-wifi-password"

// ── Firebase Realtime Database ───────────────────────────────────────────
// Host is the RTDB domain WITHOUT the https:// prefix and without a trailing slash.
#define FIREBASE_HOST    "your-project-default-rtdb.firebaseio.com"
// Web API key from Firebase console → Project settings → General → Web API Key.
#define FIREBASE_API_KEY "your-web-api-key"
